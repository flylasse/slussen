<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exactly the permissions of NFR-022 and ADR-001 section 5 (S-B-37), each for what it is listed with. The
         permission check of ADR-001 section 6.4 fails on any other and on one of these missing. -->
    <!-- The requests to the Data Providers and the Budget App. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Starting a Scheduled Fetch only while the device has a network connection (UC-001 A12, BR-013). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeping the device awake while a Scheduled Fetch runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Keeping the Fetch Schedule after the device restarts (UC-001 BR-013). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Showing the New Transaction Notification (UC-001 BR-014); the device asks the Operator for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager brings this one; a Scheduled Fetch runs no foreground work, so no use case needs it (ADR-001 section 5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Backup rules: one copy, in :persistence (ADR-002 §5). -->
    <application
        android:name=".SlussenApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.SlussenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
